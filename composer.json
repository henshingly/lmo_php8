{
    "name": "lmo/lmo_php8",
    "description": "The Liga Manager Online (LMO for short) is free software for managing sports leagues with tables on the Internet.",
    "type": "library",
    "homepage": "https://github.com/henshingly/lmo_php8",
    "keywords": [
        "LMO",
        "Liga Manager Online",
        "Sportligen verwalten"
    ],
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Rene Marth (joker)",
            "homepage": "https://www.liga-manager-online.de",
            "role": "Extension developer"
        },
        {
            "name": "Henshingly",
            "homepage": "https://www.vest-sport.de",
            "role": "Developer"
        }
    ],
    "support": {
        "forum": "https://www.liga-manager-online.org/forum/"
    },
    "require": {
        "php": ">=8.0",
        "pear/html_template_it": "^1.3.3",
        "phpmailer/phpmailer": "^7.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^9.6"
    },
    "suggest": {
        "ext-gd": "Fuer die Grafiken (Fieberkurve, Tippspiel-Grafiken)",
        "ext-zip": "Fuer Download und E-Mail-Versand der Ligadateien im Admin-Bereich"
    },
    "autoload": {
        "classmap": [
            "lmo/includes/LmoTemplate.php"
        ],
        "psr-4": {
            "Lmo\\Install\\": "src/Install/",
            "Lmo\\Liga\\": "src/Liga/"
        }
    },
    "bin": [
        "bin/lmo-install"
    ],
    "autoload-dev": {
        "psr-4": {
            "Lmo\\Tests\\GoldenMaster\\": "tests/GoldenMaster/",
            "Lmo\\Tests\\Unit\\": "tests/Unit/",
            "Lmo\\Tests\\RealData\\": "tests/RealData/"
        }
    },
    "scripts": {
        "phpstan": [
            "phpstan analyse --no-progress --memory-limit=1G",
            "phpstan analyse -c phpstan-classlib.neon.dist --no-progress --memory-limit=1G",
            "phpstan analyse -c phpstan-liga.neon.dist --no-progress --memory-limit=1G",
            "phpstan analyse -c phpstan-liga-basis.neon.dist --no-progress --memory-limit=1G",
            "phpstan analyse -c phpstan-tests.neon.dist --no-progress --memory-limit=1G",
            "phpstan analyse -c phpstan-strict.neon.dist --no-progress --memory-limit=1G"
        ],
        "test": "phpunit",
        "test:record": "GOLDEN_MODE=record phpunit"
    },
    "config": {
        "platform": {
            "php": "8.0.30"
        },
        "sort-packages": true
    }
}
