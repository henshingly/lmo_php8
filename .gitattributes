# Snapshots werden byte-genau verglichen: immer LF, auch unter Windows (core.autocrlf)
tests/GoldenMaster/__snapshots__/** text eol=lf
# Tests enthalten Ligadateien als Textblock und vergleichen sie zeilenweise: immer LF
tests/**/*.php text eol=lf
# Shell-Skripte laufen im Linux-Container: mit CRLF startet das Docker-Image nicht
*.sh text eol=lf
